{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdl.local/r6o/viewmodel_command_result.schema.json",
  "title": "ViewModelCommandResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ok", "result_type"],
  "properties": {
    "schema_version": {"const": "r6o-viewmodel-command-result-1"},
    "ok": {"type": "boolean"},
    "result_type": {"enum": ["REVISION", "FOCUS_REQUIRED", "STALE_PROJECTION", "ERROR"]},
    "projection": {"type": ["object", "null"]},
    "focus_prompt": {"type": ["string", "null"]},
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
