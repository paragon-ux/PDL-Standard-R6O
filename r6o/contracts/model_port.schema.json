{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pdl.local/r6o/model_port.schema.json",
  "title": "ModelPortContract",
  "type": "object",
  "additionalProperties": false,
  "required": ["port_version", "operations"],
  "properties": {
    "port_version": {"const": "r6o-model-port-1"},
    "operations": {
      "type": "array",
      "prefixItems": [
        {"const": "start_or_resume"},
        {"const": "read_state"},
        {"const": "read_artifact"},
        {"const": "submit_user_message"},
        {"const": "finalize"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    }
  },
  "$defs": {
    "start_or_resume_input": {"$ref": "model_session_request.schema.json"},
    "start_or_resume_output": {"$ref": "model_state_snapshot.schema.json"},
    "read_state_output": {"$ref": "model_state_snapshot.schema.json"},
    "read_artifact_output": {"$ref": "artifact_snapshot.schema.json"},
    "submit_user_message_output": {"$ref": "model_state_snapshot.schema.json"},
    "finalize_output": {"$ref": "model_state_snapshot.schema.json"},
    "error_output": {"$ref": "model_port_error.schema.json"}
  }
}
